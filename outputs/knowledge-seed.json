        "general_intro"
      ],
      "retrievalPrompts": [
        "节拍细分",
        "如何在歌曲中练习节拍细分"
      ],
      "assessment": {
        "method": "demonstration_and_self_explanation",
        "requiresRecording": false
      }
    },
    {
      "id": "K03",
      "title": "和弦音优先",
      "language": "zh-CN",
      "tags": [
        "chord"
      ],
      "level": "early-intermediate",
      "prerequisites": [
        "K01"
      ],
      "sourceRefs": [
        "S03"
      ],
      "explanation": "和弦音是组成和弦的音。学习贝斯线可以优先理解和弦轮廓，再学习音阶音如何连接这些落点。",
      "exercise": "在 Am7 上分别只用 A，以及 A/C/E/G，保持相同节奏比较。",
      "caveat": "这是教材的教学立场，不是要求每个音都属于和弦。",
      "evidenceType": "source_based_paraphrase",
      "reviewStatus": "draft_needs_bass_teacher_review",
      "version": "0.1",
      "styleScope": [
        "general_intro"
      ],
      "retrievalPrompts": [
        "和弦音优先",
        "如何在歌曲中练习和弦音优先"
      ],
      "assessment": {
        "method": "demonstration_and_self_explanation",
        "requiresRecording": false
      }
    },
    {
      "id": "K04",
      "title": "半音与全音",
      "language": "zh-CN",
      "tags": [
        "interval"
      ],
      "level": "early-intermediate",
      "prerequisites": [],
      "sourceRefs": [
        "S07"
      ],
      "explanation": "十二平均律中相邻品相差一个半音；两个半音为一个全音。",
      "exercise": "同弦弹 5、6、7 品，听半音和全音距离。",
      "caveat": "不同调弦影响跨弦形状，不改变同弦相邻品关系。",
      "evidenceType": "source_based_paraphrase",
      "reviewStatus": "draft_needs_bass_teacher_review",
      "version": "0.1",
      "styleScope": [
        "general_intro"
      ],
      "retrievalPrompts": [
        "半音与全音",
        "如何在歌曲中练习半音与全音"
      ],
      "assessment": {
        "method": "demonstration_and_self_explanation",
        "requiresRecording": false
      }
