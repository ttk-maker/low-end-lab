    {
      "id": "K06",
      "title": "八度与同音异位",
      "language": "zh-CN",
      "tags": [
        "fretboard"
      ],
      "level": "early-intermediate",
      "prerequisites": [
        "K05"
      ],
      "sourceRefs": [
        "S11"
      ],
      "explanation": "八度频率比为 2:1。标准调弦中，高两根弦并高两品常得到高八度；同弦高 12 品也是高八度。",
      "exercise": "比较 E5、A0 与 G2，区分同一实音和高八度。",
      "caveat": "必须检查弦数和品位边界。",
      "evidenceType": "source_based_paraphrase",
