    {
      "id": "K16",
      "title": "从目标倒推加花",
      "language": "zh-CN",
      "tags": [
        "connection",
        "arrangement"
      ],
      "level": "early-intermediate",
      "prerequisites": [
        "K09",
        "K14"
      ],
      "sourceRefs": [
        "S04"
      ],
      "explanation": "练习连接时可以先固定下一和弦目标，再在前一小节末尾尝试少量趋近音。",
