    {
      "id": "K05",
      "title": "标准四度调弦",
      "language": "zh-CN",
      "tags": [
        "fretboard"
      ],
      "level": "early-intermediate",
      "prerequisites": [
        "K04"
      ],
      "sourceRefs": [
        "S07"
      ],
      "explanation": "四弦标准调弦从低到高为 E、A、D、G，相邻空弦为纯四度，间隔 5 半音。",
      "exercise": "比较 E 弦 5 品与 A 空弦。",
      "caveat": "调弦改变后，不能继续机械套用五半音跨弦公式。",
      "evidenceType": "source_based_paraphrase",
      "reviewStatus": "draft_needs_bass_teacher_review",
